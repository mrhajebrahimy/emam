{
  "name": "amoozyar",
  "productName": "Amoozyar",
  "version": "1.0.0",
  "description": "آموزیار — پلتفرم یادگیری تطبیقی",
  "author": "Amoozyar Team",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.js",
    "desktop": "npm run prepare:web && electron .",
    "dist:desktop": "npm run prepare:web && electron-builder",
    "cap:sync": "npm run prepare:web && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ir.amoozyar.app",
    "productName": "Amoozyar",
    "directories": { "buildResources": "resources", "output": "release" },
    "files": ["electron/**", "www/**", "resources/icon.png", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "resources/icon.png" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.education", "icon": "resources/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Education", "icon": "resources/icon.png", "maintainer": "Amoozyar Team <team@amoozyar.local>" },
    "artifactName": "Amoozyar-${version}-${os}-${arch}.${ext}"
  }
}
